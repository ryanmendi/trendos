generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  price       Float
  oldPrice    Float?
  discount    Float?
  rating      Float?
  reviews     Int?
  image       String?
  url         String @unique
  store       String

  viralScore      Float? @default(0)
  conversionScore Float? @default(0)
  saturationScore Float? @default(0)

  growthScore     Float? @default(0)
  trendScore      Float? @default(0)
  saturationLevel Float? @default(0)

  viralCategory   String?

  posted      Boolean @default(false)

  createdAt   DateTime @default(now())
}

model ContentPerformance {
  id String @id @default(cuid())

  productTitle String

  hook String
  cta  String

  predictedScore Float

  views    Int?
  clicks   Int?
  sales    Int?

  engagementRate Float?

  createdAt DateTime @default(now())
}

model TrendSnapshot {
  id        String   @id @default(cuid())

  keyword   String

  value     Float?

  growth    Float?

  createdAt DateTime @default(now())
}